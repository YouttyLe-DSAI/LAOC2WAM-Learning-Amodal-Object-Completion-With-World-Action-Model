    "import cv2\n",
    "import numpy as np\n",
    "import random\n",
    "\n",
    "bp_path = \"data/train_ready/instance_images/backpack_0.jpg\"\n",
    "image_bgr = cv2.imread(bp_path)\n",
    "image_bgr = cv2.resize(image_bgr, (256, 256))\n",
    "\n",
    "amodal_gt = synth.estimate_object_mask(image_bgr)\n",
    "\n",
    "rng = random.Random(7)\n",
    "occluded_bgr, occluder_mask = synth.add_synthetic_occluder(image_bgr, amodal_gt, rng)\n",
    "occluded_rgb = cv2.cvtColor(occluded_bgr, cv2.COLOR_BGR2RGB)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.amodal_pipeline.mask_model import AmodalMaskUNet\n",
    "from torchvision import transforms\n",
    "\n",
    "mask_model = AmodalMaskUNet(base_ch=32).to(\"cuda\")\n",
    "mask_model.load_state_dict(torch.load(\"outputs/mask_model/best.pt\"))\n",
    "mask_model.eval()\n",
    "\n",
    "img_pil = Image.fromarray(occluded_rgb)\n",
    "img_t = transforms.ToTensor()(img_pil).unsqueeze(0).to(\"cuda\")\n",
    "\n",
    "visible_mask = np.logical_and(amodal_gt > 0, occluder_mask == 0).astype(np.float32)\n",
    "vis_t = torch.from_numpy(visible_mask).unsqueeze(0).unsqueeze(0).to(\"cuda\")\n",
    "\n",
    "with torch.no_grad():\n",
    "    pred_mask = torch.sigmoid(mask_model(img_t, vis_t))[0, 0].cpu().numpy() > 0.5"
   ]
  },
